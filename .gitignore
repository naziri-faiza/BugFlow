# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Production builds
dist/
frontend/dist/
dist-ssr/
*.local

# Environment & Secrets (NEVER commit real credentials)
.env
.env.*
backend/.env
frontend/.env.development
frontend/.env.local
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Only ignore stray root-level lockfile if present, preserving backend/ and frontend/ lockfiles
/package-lock.json
